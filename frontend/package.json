{
  "name": "slide-notes",
  "version": "0.3.2",
  "private": true,
  "description": "Local slide-first Python notebook",
  "scripts": {
    "check": "node scripts/check.mjs",
    "build": "node scripts/build.mjs",
    "build:assets": "node scripts/build.mjs --assets",
    "build:editor": "node scripts/build.mjs --editor",
    "build:markdown": "node scripts/build.mjs --markdown",
    "build:workbench": "node scripts/build.mjs --workbench",
    "test:ai-response": "node --test ../tests/frontend/test_ai_response.cjs",
    "test:ai-ui": "node ../tests/frontend/test_ai_ui.cjs",
    "test:markdown-ui": "node --test ../tests/frontend/test_obsidian_markdown.cjs",
    "test:cell-ui": "node ../tests/frontend/test_code_cell_ui.cjs",
    "test:markdown-browser": "node --test ../tests/frontend/test_obsidian_markdown.cjs",
    "test:file-tree": "node ../tests/frontend/test_file_tree.cjs",
    "test:ai-settings": "node --test ../tests/frontend/test_ai_settings.cjs",
    "test:ai-interface": "node --test ../tests/frontend/test_ai_interface.cjs",
    "test:markdown-app": "node --test ../tests/frontend/test_obsidian_app.cjs",
    "test": "node --test --test-concurrency=2 ../tests/frontend/test_*.cjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@dagrejs/dagre": "3.1.1",
    "@fontsource/fira-mono": "5.3.0",
    "@fontsource/pt-sans": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.8.0",
    "dompurify": "3.4.16",
    "katex": "0.19.0",
    "lucide-static": "1.53.0",
    "mathjax-full": "3.2.2",
    "mdast-util-to-hast": "13.2.0",
    "mermaid": "11.12.0",
    "pdfjs-dist": "6.4.299",
    "prismjs": "1.30.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
